---
import BaseLayout from '@layouts/BaseLayout.astro';
import { SOURCES, UPDATE_LOG, ARTICLES } from '@lib/content';

const byAuthority = (auth) => SOURCES.filter((s) => s.authority === auth);
---

<BaseLayout title="Research & Sources" description="DhanPedia's source registry — every claim's citation spine, with verification dates and authority level.">
  <section style="padding:3rem 0 3rem;">
    <div class="container" style="max-width:52rem;">
      <h1 style="font-size:2rem; margin:0 0 .4rem;">Research &amp; sources</h1>
      <p style="color:var(--ink-soft);">
        This is the citation spine for the whole encyclopedia. Every time-sensitive
        claim in an article points to an entry here. <strong style="color:var(--ink)">Primary</strong>
        sources are official regulators, statutes, or government bodies;
        <strong style="color:var(--ink)"> secondary</strong> are reputable summaries.
        No URL, date, or quote is fabricated — if a source couldn't be retrieved,
        the claim is labelled unverified.
      </p>

      <h2 style="font-size:1.2rem; margin:2rem 0 .6rem;">Source registry ({SOURCES.length})</h2>
      <div style="display:grid; gap:.6rem;">
        {[...byAuthority('primary'), ...byAuthority('secondary')].map((s) => {
          const usedBy = ARTICLES.filter((a) => (Array.isArray(a.sources) ? a.sources : []).includes(s.id)).map((a) => a.title);
          return (
            <div style="background:var(--surface); border:1px solid var(--line); border-radius:10px; padding:.9rem 1.1rem;">
              <div style="display:flex; align-items:center; gap:.5rem; flex-wrap:wrap;">
                <span style={`font-size:.68rem; font-weight:700; padding:.15rem .5rem; border-radius:20px; ${s.authority === 'primary' ? 'background:var(--gold-soft); color:var(--ink);' : 'background:var(--surface-2); color:var(--ink-soft);'}`}>{s.authority}</span>
                <span style="font-size:.72rem; color:var(--ink-soft); text-transform:uppercase; letter-spacing:.05em;">{s.type}</span>
                {s.verified && <span style="font-size:.72rem; color:var(--ink-soft); margin-left:auto;">verified {s.verified}</span>}
              </div>
              <div style="font-weight:600; color:var(--ink); margin-top:.4rem; font-size:.95rem;">{s.title}</div>
              <div style="font-size:.85rem; color:var(--ink-soft);">{s.publisher}</div>
              <a href={s.url} target="_blank" rel="noopener noreferrer" style="font-size:.8rem; word-break:break-all;">{s.url}</a>
              {s.limitations && <div style="font-size:.78rem; color:var(--warn); margin-top:.3rem;">⚠ {s.limitations}</div>}
              {usedBy.length > 0 && <div style="font-size:.75rem; color:var(--ink-soft); margin-top:.3rem;">Cited by: {usedBy.join(', ')}</div>}
            </div>
          );
        })}
      </div>

      <h2 style="font-size:1.2rem; margin:2.5rem 0 .6rem;">Update register ({UPDATE_LOG.length} time-sensitive claims)</h2>
      <table style="width:100%; border-collapse:collapse; font-size:.85rem;">
        <thead><tr><th style="text-align:left; padding:.4rem .6rem; border:1px solid var(--line);">Claim</th><th style="text-align:left; padding:.4rem .6rem; border:1px solid var(--line);">Last verified</th><th style="text-align:left; padding:.4rem .6rem; border:1px solid var(--line);">Review by</th><th style="text-align:left; padding:.4rem .6rem; border:1px solid var(--line);">Status</th></tr></thead>
        <tbody>
          {UPDATE_LOG.map((u) => (
            <tr>
              <td style="padding:.4rem .6rem; border:1px solid var(--line);">{u.claim}</td>
              <td style="padding:.4rem .6rem; border:1px solid var(--line);">{u.lastVerified}</td>
              <td style="padding:.4rem .6rem; border:1px solid var(--line);">{u.reviewAfter}</td>
              <td style="padding:.4rem .6rem; border:1px solid var(--line);"><span style={`font-size:.72rem; font-weight:700; padding:.1rem .45rem; border-radius:20px; ${u.status === 'needs-review' ? 'background:color-mix(in srgb, var(--warn) 18%, transparent); color:var(--warn);' : 'background:var(--gold-soft); color:var(--ink);'}`}>{u.status}</span></td>
            </tr>
          ))}
        </tbody>
      </table>
      <p style="font-size:.8rem; color:var(--ink-soft); margin-top:.6rem;">CI may flag items past <code>review by</code> but will never auto-publish regulatory changes.</p>
    </div>
  </section>
</BaseLayout>
