{
  "name": "dhanpedia",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "India's Encyclopedia of Investing, Money & Wealth — a free, evidence-based educational publishing platform.",
  "author": "Chirag Singhal <chirag@oriz.in>",
  "license": "CC-BY-4.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "node scripts/generate-books.mjs && astro build && npx pagefind --site dist --output-path dist/pagefind && node scripts/validate-content.mjs && node scripts/check-links.mjs && node scripts/build-report.mjs",
    "preview": "astro preview",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "e2e:install": "playwright install chromium",
    "books": "node scripts/generate-books.mjs",
    "validate": "node scripts/validate-content.mjs",
    "check-links": "node scripts/check-links.mjs",
    "report": "node scripts/build-report.mjs",
    "search": "pagefind --site dist --output-path dist/pagefind"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.3.3",
    "@astrojs/mdx": "^8.1.0",
    "@astrojs/react": "^7.1.0",
    "@astrojs/sitemap": "^3.7.4",
    "@fontsource-variable/inter": "^5.2.0",
    "@fontsource-variable/source-serif-4": "^5.2.0",
    "astro": "^7.4.0",
    "echarts": "^6.1.0",
    "jszip": "^3.10.1",
    "katex": "^0.16.15",
    "lucide-react": "^0.539.0",
    "mermaid": "^11.5.0",
    "pagefind": "^1.5.2",
    "pdfkit": "^0.15.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "rehype-katex": "^7.0.1",
    "remark-math": "^6.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
