{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@lib/*": ["./src/lib/*"],
      "@components/*": ["./src/components/*"],
      "@layouts/*": ["./src/layouts/*"],
      "@styles/*": ["./src/styles/*"],
      "@content/*": ["./src/content/*"],
      "@registry/*": ["./content-registry/*"],
      "@data/*": ["./src/data/*"],
      "@types/*": ["./types/*"]
    },
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "lib": ["ES2022", "DOM", "DOM.Iterable"]
  },
  "include": [
    "src/**/*",
    "content-registry/**/*",
    "scripts/**/*",
    "tests/**/*",
    "astro.config.ts",
    "env.d.ts"
  ],
  "exclude": ["node_modules", "dist", "books/dist"]
}
